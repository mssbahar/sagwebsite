---
import InnerPage from "../InnerPage.astro";
import BranchMap from "../locations/BranchMap.astro";
import BranchListItem from "../locations/BranchListItem.astro";
import CtaBanner from "../CtaBanner.astro";
import PinkDot from "../PinkDot.astro";
import { Search, LocateFixed } from "@lucide/astro";
import { mapBranches, featuredBranch } from "../../../data/branches";
---

<InnerPage view="locations">
  <div class="w-full pb-6">
    <div class="reveal">
      <div class="mb-4 flex items-center gap-3">
        <PinkDot icon="MapPin" />
        <p class="text-xs uppercase tracking-[0.22em] text-white/75">Locations</p>
      </div>
      <h1 class="text-shine mb-2 text-4xl font-black leading-[1.0] tracking-tight md:text-5xl">
        Our Branches
      </h1>
      <p class="max-w-xl text-sm leading-relaxed text-white/70">
        Search by state, city or postcode — or find the branch nearest you.
      </p>
    </div>
  </div>

  <div class="reveal mb-10 grid grid-cols-1 gap-5 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.25fr)] md:items-stretch">
    <!-- Left: select store -->
    <div data-branch-store class="branch-store flex min-h-0 flex-col">
      <div class="mb-3 flex flex-col gap-2 sm:flex-row sm:items-center">
        <label class="branch-search relative min-w-0 flex-1">
          <span class="sr-only">Search branches by state, city or postcode</span>
          <Search
            size={16}
            class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-white/40"
            aria-hidden="true"
          />
          <input
            type="search"
            data-branch-search
            placeholder="State, city or postcode"
            autocomplete="off"
            class="branch-search__input focus-ring w-full"
          />
        </label>
        <button
          type="button"
          data-find-nearest
          class="branch-nearest focus-ring inline-flex shrink-0 items-center justify-center gap-2"
        >
          <LocateFixed size={16} aria-hidden="true" />
          <span data-find-nearest-label>Find nearest</span>
        </button>
      </div>

      <p data-branch-status class="mb-2 min-h-[1.25rem] text-xs text-white/50" aria-live="polite"></p>

      <div
        data-branch-list
        class="branch-store__list flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto pr-1"
        role="list"
      >
        {
          mapBranches.map((b) => (
            <div role="listitem">
              <BranchListItem branch={b} active={b.id === featuredBranch.id} />
            </div>
          ))
        }
      </div>

      <p data-branch-empty class="mt-4 hidden text-sm text-white/50" hidden>
        No branches match that search.
      </p>
    </div>

    <!-- Right: map -->
    <div class="branch-store__map min-h-[280px] md:min-h-[420px] lg:min-h-[520px]">
      <BranchMap branches={mapBranches} />
    </div>
  </div>

  <div class="reveal w-full pb-10">
    <CtaBanner heading="A branch near you,<br />wherever you are." bgImg="/images/branches/branch-09.jpg" />
  </div>
</InnerPage>
