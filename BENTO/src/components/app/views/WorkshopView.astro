---
import InnerPage from "../InnerPage.astro";
import CtaBanner from "../CtaBanner.astro";
import PinkDot from "../PinkDot.astro";
import {
  facilities,
  workshopHero,
  workshopCta,
} from "../../../data/facilities";
---

<InnerPage view="workshop">
  <section class="services-hero mb-12 grid grid-cols-1 items-center gap-8 md:mb-16 md:grid-cols-2 md:gap-10 lg:gap-12">
    <div class="reveal-image relative order-2 aspect-[4/3] overflow-hidden rounded-2xl border border-white/10 md:order-1 md:aspect-auto md:min-h-[20rem] lg:min-h-[24rem]">
      <div
        data-workshop-hero-img
        class="absolute inset-0 scale-105 bg-cover bg-center"
        style={`background-image:url(${workshopHero.image})`}
        role="img"
        aria-label={workshopHero.imageAlt}
      ></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
    </div>

    <div class="order-1 md:order-2">
      <div class="reveal-fade mb-5 flex items-center gap-3">
        <PinkDot icon="Settings" />
        <p class="text-xs uppercase tracking-[0.22em] text-white/75">{workshopHero.eyebrow}</p>
      </div>
      <h1 class="text-shine reveal mb-5 text-4xl font-black leading-[1.02] tracking-tight md:text-5xl lg:text-[3.25rem]">
        {workshopHero.headline}
      </h1>
      <p class="reveal text-sm leading-relaxed text-white/75 md:text-base">{workshopHero.intro}</p>
    </div>
  </section>

  <section class="workshop-floor border-t border-white/10 pt-10 md:pt-12">
    <div class="reveal-fade mb-10 md:mb-12">
      <p class="mb-2 text-[10px] uppercase tracking-[0.28em] text-accent">On the floor</p>
      <h2 class="text-2xl font-black md:text-3xl">Four bays. One standard.</h2>
    </div>

    <div data-workshop-floor class="workshop-floor__list">
      {
        facilities.map((f, i) => (
          <article
            data-workshop-bay
            data-facility-id={f.id}
            class:list={["workshop-bay", i % 2 === 1 && "workshop-bay--flip"]}
          >
            <div class="workshop-bay__rail" aria-hidden="true">
              <span class="workshop-bay__node">{f.no}</span>
            </div>

            <div class="workshop-bay__body">
              <div class="workshop-bay__visual">
                <div
                  data-workshop-bay-img
                  class="workshop-bay__image"
                  style={`background-image:url(${f.image})`}
                  role="img"
                  aria-label={f.title}
                ></div>
                <span class="workshop-bay__watermark">{f.no}</span>
              </div>

              <div class="workshop-bay__copy">
                <div class="mb-4 flex items-center gap-3">
                  <PinkDot icon={f.icon} />
                  <p class="workshop-bay__label">Bay {f.no}</p>
                </div>
                <h3 class="workshop-bay__title">{f.title}</h3>
                <p class="workshop-bay__tagline">{f.tagline}</p>
                <p class="workshop-bay__desc">{f.longDescription}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <div class="reveal w-full border-t border-white/10 pt-10 pb-6 md:pt-12 md:pb-10">
    <CtaBanner
      heading={workshopCta.heading}
      cta={workshopCta.cta}
      bgImg={workshopCta.bgImg}
    />
  </div>
</InnerPage>
