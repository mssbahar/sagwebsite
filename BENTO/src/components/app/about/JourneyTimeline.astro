---
import type { AboutTimelineItem } from "../../../data/about";

interface Props {
  items: AboutTimelineItem[];
}

const { items } = Astro.props;

const rows: AboutTimelineItem[][] = [];
for (let i = 0; i < items.length; i += 2) {
  rows.push(items.slice(i, i + 2));
}
---

<div data-journey-timeline class="about-journey">
  {
    rows.map((pair, rowIndex) => {
      const rtl = rowIndex % 2 === 1;
      const isLast = rowIndex === rows.length - 1;

      return (
        <div
          class:list={["about-journey__row", rtl && "is-rtl", pair.length === 1 && "is-single"]}
          data-journey-row
          data-journey-dir={rtl ? "rtl" : "ltr"}
        >
          <ol class="about-journey__pair">
            {pair.map((item) => (
              <li data-journey-item class="about-journey__item">
                <article data-journey-card class="about-journey__card">
                  <div class="about-journey__media">
                    <img
                      src={item.image}
                      alt={item.imageAlt}
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="360"
                    />
                  </div>

                  <div class="about-journey__content">
                    <div class="about-journey__body">
                      <h3 class="about-journey__title">{item.title}</h3>
                      <p class="about-journey__desc">{item.description}</p>
                    </div>

                    <div
                      class="about-journey__date"
                      aria-label={`${item.month ?? ""} ${item.day ?? ""} ${item.year}`.trim()}
                    >
                      {item.month && <span class="about-journey__month">{item.month}</span>}
                      {item.day ? (
                        <span class="about-journey__day">{item.day}</span>
                      ) : (
                        <span class="about-journey__day about-journey__day--year">{item.year}</span>
                      )}
                      {item.day && <span class="about-journey__year">{item.year}</span>}
                    </div>
                  </div>
                </article>

                <span class="about-journey__node" aria-hidden="true"></span>
              </li>
            ))}
          </ol>

          <div class="about-journey__path" aria-hidden="true">
            <span class="about-journey__hrail" data-journey-hrail></span>
            {!isLast && <span class="about-journey__vrail" data-journey-vrail></span>}
          </div>
        </div>
      );
    })
  }
</div>
