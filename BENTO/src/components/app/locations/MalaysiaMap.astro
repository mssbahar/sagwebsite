---
import type { Branch } from "../../../data/branches";
import { branchPayload } from "../../../data/branches";

interface Props {
  branches: Branch[];
}

const { branches } = Astro.props;
---

<div data-map-stage class="relative h-full min-h-[280px] w-full overflow-hidden rounded-2xl border border-white/10 bg-[#0a0a0a] lg:min-h-[520px]">
  <div class="absolute inset-0 flex items-center justify-center p-4 md:p-8">
    <div data-map-group class="relative h-full w-full max-w-3xl origin-center will-change-transform">
      <svg
        viewBox="0 0 400 240"
        class="h-full w-full"
        aria-hidden="true"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect width="400" height="240" fill="#0d0d0d" rx="12" />
        <!-- Peninsular Malaysia -->
        <path
          d="M72 48 L118 38 L156 52 L168 78 L162 108 L148 132 L128 156 L108 168 L88 158 L70 132 L62 98 Z"
          fill="#161616"
          stroke="#2a2a2a"
          stroke-width="1.5"
        />
        <!-- East Malaysia -->
        <path
          d="M268 88 L318 72 L348 98 L342 132 L312 148 L278 138 L262 112 Z"
          fill="#141414"
          stroke="#2a2a2a"
          stroke-width="1.5"
        />
        <path
          d="M292 148 L338 138 L358 162 L348 188 L312 196 L286 178 Z"
          fill="#141414"
          stroke="#2a2a2a"
          stroke-width="1.5"
        />
        <!-- Grid lines -->
        <g stroke="#1f1f1f" stroke-width="0.5">
          <line x1="0" y1="60" x2="400" y2="60" />
          <line x1="0" y1="120" x2="400" y2="120" />
          <line x1="0" y1="180" x2="400" y2="180" />
          <line x1="80" y1="0" x2="80" y2="240" />
          <line x1="160" y1="0" x2="160" y2="240" />
          <line x1="240" y1="0" x2="240" y2="240" />
          <line x1="320" y1="0" x2="320" y2="240" />
        </g>
      </svg>

      {
        branches.map((b) =>
          b.map ? (
            <button
              type="button"
              data-map-pin
              data-branch-id={b.id}
              data-map-x={b.map.x}
              data-map-y={b.map.y}
              data-branch={branchPayload(b)}
              aria-label={`${b.name} branch`}
              aria-pressed="false"
              class="map-pin focus-ring absolute -translate-x-1/2 -translate-y-1/2"
              style={`left:${b.map.x}%;top:${b.map.y}%`}
            >
              <span class="map-pin-dot" aria-hidden="true"></span>
              <span class="map-pin-label">{b.name}</span>
            </button>
          ) : null,
        )
      }
    </div>
  </div>
  <p class="pointer-events-none absolute bottom-3 left-4 text-[10px] uppercase tracking-[0.2em] text-white/40">
    Tap a pin to explore
  </p>
</div>
