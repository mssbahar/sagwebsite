---
import "../styles/global.css";
import AudioPlayer from "../components/app/AudioPlayer.astro";
import ExploreCloseCta from "../components/app/ExploreCloseCta.astro";
import SiteLoader from "../components/app/SiteLoader.astro";
import { site } from "../data/site";
import { branches } from "../data/branches";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.description } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AutoRepair",
  name: site.name,
  telephone: site.phone,
  email: site.email,
  url: site.url,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.hqAddress,
    addressCountry: "MY",
  },
  location: branches
    .filter((b) => b.region !== "TBD")
    .map((b) => ({
      "@type": "AutoRepair",
      name: `${site.shortName} ${b.name}`,
      address: b.address,
      telephone: b.phone,
    })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logo-primary.png" />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var h = location.hash.replace(/^#/, "");
        if (h && h !== "landing" && h !== "dashboard") {
          document.documentElement.dataset.hashInner = h;
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div id="app" class="bg-black">
      <SiteLoader />
      <div
        id="overlay-backdrop"
        class="pointer-events-none fixed inset-0 z-[15] opacity-0"
      ></div>
      <slot />
      <ExploreCloseCta />
      <AudioPlayer />
    </div>

    <script>
      import { initSiteLoader } from "../scripts/loader";
      import { initPageMotions, syncActivePageMotion } from "../scripts/page-motions";
      import { initAudio } from "../scripts/audio";
      import { initViews } from "../scripts/views";
      import { initReveals } from "../scripts/reveals";
      import { initCarousel } from "../scripts/carousel";
      import { initLenis } from "../scripts/lenis";

      await initSiteLoader();
      initReveals();
      initLenis();
      initPageMotions();
      initViews();
      syncActivePageMotion();
      initCarousel();
      initAudio();
    </script>
  </body>
</html>
