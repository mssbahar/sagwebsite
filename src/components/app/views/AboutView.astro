---
import InnerPage from "../InnerPage.astro";
import CtaBanner from "../CtaBanner.astro";
import PinkDot from "../PinkDot.astro";
import CarGets from "../about/CarGets.astro";
import {
  aboutHero,
  aboutPerformance,
  aboutVision,
  aboutFuturePlans,
  aboutCta,
} from "../../../data/about";
---

<InnerPage view="about">
  <!-- 363-style split hero -->
  <section class="about-hero mb-14 grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-10 lg:gap-12">
    <div class="reveal-image relative order-2 aspect-[4/3] overflow-hidden rounded-2xl border border-white/10 md:order-1 md:aspect-auto md:min-h-[22rem] lg:min-h-[26rem]">
      <div
        data-parallax-img
        data-about-hero-img
        class="absolute inset-0 scale-105 bg-cover bg-center"
        style={`background-image:url(${aboutHero.image})`}
        role="img"
        aria-label={aboutHero.imageAlt}
      ></div>
    </div>

    <div class="order-1 md:order-2">
      <div class="reveal-fade mb-5 flex items-center gap-3">
        <PinkDot icon="Info" />
        <p class="text-xs uppercase tracking-[0.22em] text-white/75">{aboutHero.eyebrow}</p>
      </div>
      <div class="line-reveal-mask mb-5">
        <h1 class="text-shine text-4xl font-black leading-[1.02] tracking-tight md:text-5xl lg:text-[3.25rem]" data-line-reveal>
          {aboutHero.headline}
        </h1>
      </div>
      <p class="reveal text-sm leading-relaxed text-white/75 md:text-base">{aboutHero.intro}</p>
    </div>
  </section>

  <!-- Vision -->
  <section class="about-vision about-section mb-14" aria-labelledby="about-vision-heading">
    <div class="reveal-fade mb-5 flex items-center gap-3">
      <PinkDot icon="Eye" />
      <p class="text-xs uppercase tracking-[0.22em] text-white/75">{aboutVision.eyebrow}</p>
    </div>
    <div class="about-vision__layout">
      <div class="line-reveal-mask">
        <h2 id="about-vision-heading" class="about-vision__title text-3xl font-black leading-tight tracking-tight md:text-5xl" data-line-reveal>
          {aboutVision.headline}
        </h2>
      </div>
      <div class="about-vision__copy">
        <p class="about-vision__lead">{aboutVision.lead}</p>
        <p class="about-vision__body">{aboutVision.body}</p>
      </div>
    </div>
  </section>

  <!-- Performance -->
  <section class="about-record about-section mb-14" aria-labelledby="about-record-heading">
    <div class="reveal-fade mb-3 flex items-center gap-3">
      <PinkDot icon="TrendingUp" />
      <p id="about-record-heading" class="text-xs uppercase tracking-[0.22em] text-white/75">{aboutPerformance.eyebrow}</p>
    </div>
    <p class="reveal-fade max-w-xl text-sm text-white/60">{aboutPerformance.tagline}</p>

    <dl class="about-record__list">
      {
        aboutPerformance.stats.map((stat, i) => (
          <div class="about-record__item">
            <dt>{stat.label}</dt>
            <dd
              data-counter={String(stat.value)}
              data-counter-index={String(i)}
              data-suffix={stat.suffix ?? ""}
              data-numeric={stat.numeric ? "true" : "false"}
            >
              {typeof stat.value === "number" && stat.value >= 10000 ? stat.value.toLocaleString() : stat.value}
              {stat.suffix ?? ""}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <CarGets />

  <!-- Future plans -->
  <section class="about-section mb-14 border-t border-white/10 pt-10">
    <div class="reveal-fade mb-3 flex items-center gap-3">
      <PinkDot icon="Sparkles" />
      <p class="text-xs uppercase tracking-[0.22em] text-white/75">Our Future Plans</p>
    </div>
    <p class="reveal-fade mb-8 max-w-2xl text-sm leading-relaxed text-white/60">
      Where SAG is headed next — select a pillar below to read more.
    </p>

    <div data-about-plans-grid class="about-plans">
      {
        aboutFuturePlans.map((plan) => (
          <article
            data-about-plan
            class="about-plan focus-ring"
            tabindex="0"
            role="button"
            aria-expanded="false"
            aria-label={`${plan.title}. Select to read more.`}
          >
            <img
              class="about-plan__img"
              src={plan.image}
              alt={plan.imageAlt}
              loading="lazy"
              decoding="async"
              width="640"
              height="860"
            />
            <div class="about-plan__copy">
              <span class="about-plan__num" aria-hidden="true">{plan.number}</span>
              <h3 class="about-plan__title">{plan.title}</h3>
              <p class="about-plan__teaser">{plan.teaser}</p>
              <p class="about-plan__detail">{plan.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="about-section pb-4">
    <div class="reveal">
      <CtaBanner heading={aboutCta.heading} cta={aboutCta.cta} bgImg={aboutCta.bgImg} />
    </div>
  </section>
</InnerPage>
