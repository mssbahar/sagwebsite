---
import InnerPage from "../InnerPage.astro";
import CtaBanner from "../CtaBanner.astro";
import PinkDot from "../PinkDot.astro";
import { services, servicesHero, serviceProcess, servicesCta } from "../../../data/services";
---

<InnerPage view="services">
  <!-- Split hero -->
  <section class="services-hero mb-12 grid grid-cols-1 items-center gap-8 md:mb-16 md:grid-cols-2 md:gap-10 lg:gap-12">
    <div class="reveal-image relative order-2 aspect-[4/3] overflow-hidden rounded-2xl border border-white/10 md:order-1 md:aspect-auto md:min-h-[20rem] lg:min-h-[24rem]">
      <div
        data-services-hero-img
        class="absolute inset-0 scale-105 bg-cover bg-center"
        style={`background-image:url(${servicesHero.image})`}
        role="img"
        aria-label={servicesHero.imageAlt}
      ></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
    </div>

    <div class="order-1 md:order-2">
      <div class="reveal-fade mb-5 flex items-center gap-3">
        <PinkDot icon="Wrench" />
        <p class="text-xs uppercase tracking-[0.22em] text-white/75">{servicesHero.eyebrow}</p>
      </div>
      <h1 class="text-shine reveal mb-5 text-4xl font-black leading-[1.02] tracking-tight md:text-5xl lg:text-[3.25rem]">
        {servicesHero.headline}
      </h1>
      <p class="reveal text-sm leading-relaxed text-white/75 md:text-base">{servicesHero.intro}</p>
    </div>
  </section>

  <section class="services-work border-t border-white/10 pt-10 md:pt-12">
    <div class="reveal-fade mb-8 md:mb-10">
      <p class="mb-2 text-[10px] uppercase tracking-[0.28em] text-accent">Service catalog</p>
      <h2 class="text-2xl font-black md:text-3xl">What we do for your car</h2>
    </div>

    <div class="service-sheet">
      {
        services.map((service, i) => (
          <article class:list={["service-sheet__row reveal", i % 2 === 1 && "service-sheet__row--flip"]}>
            <img class="service-sheet__photo" src={service.image} alt="" />
            <div class="service-sheet__copy">
              <p class="service-sheet__index">{String(i + 1).padStart(2, "0")}</p>
              <h3 class="service-sheet__title">{service.title}</h3>
              <p class="service-sheet__tagline">{service.tagline}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="services-process border-t border-white/10 py-12 md:py-16">
    <div class="reveal-fade mb-8 md:mb-10">
      <p class="mb-2 text-[10px] uppercase tracking-[0.28em] text-accent">The process</p>
      <h2 class="text-2xl font-black md:text-3xl">How it works</h2>
    </div>

    <ol class="job-track">
      {
        serviceProcess.map((step) => (
          <li class="job-track__stop reveal">
            <span class="job-track__node" aria-hidden="true">{step.step}</span>
            <div class="job-track__body">
              <h3 class="job-track__status">{step.title}</h3>
              <p class="job-track__note">{step.description}</p>
              {
                step.image && (
                  <img class="job-track__photo" src={step.image} alt={step.imageAlt} />
                )
              }
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="reveal w-full pb-6 md:pb-10">
    <CtaBanner heading={servicesCta.heading} bgImg={servicesCta.bgImg} />
  </div>
</InnerPage>
