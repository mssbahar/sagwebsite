---
import { ArrowUpRight } from "@lucide/astro";
import CtaButton from "./CtaButton.astro";
import { site } from "../../data/site";
import { landingCopy } from "../../data/trust";
---

<section data-view="landing" data-scroll="false" data-landing-phase="cinema" class="view bg-black">
  <div class="relative h-full w-full overflow-hidden">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      data-landing-video
      playsinline
      preload="auto"
      poster="/images/herovisual.png"
    >
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <div class="pointer-events-none absolute inset-0 bg-black" data-landing-veil></div>

    <div class="absolute inset-0 z-10" data-landing-home hidden>
      <div class="pointer-events-none absolute inset-0 bg-black/25"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/40 via-black/25 to-black/45"></div>

      <div class="landing-header absolute inset-x-3 top-3 z-20 flex items-center justify-between rounded-2xl border border-white/10 bg-black/45 px-4 py-3 backdrop-blur-md md:inset-x-0 md:top-0 md:rounded-none md:border-0 md:bg-transparent md:px-10 md:py-8 md:backdrop-blur-none lg:pr-16">
        <img
          src="/images/logo-primary.png"
          alt="Smart Autocare Garage"
          class="hero-item h-9 w-9 shrink-0 object-contain sm:h-10 sm:w-10 md:h-12 md:w-12"
        />
        <div class="hero-item flex items-center gap-3 md:gap-4">
          <CtaButton href={site.whatsappUrl} external class="text-sm text-white/90">
            <span class="hidden sm:inline">Book Now</span>
            <span class="sm:hidden">Book</span>
            <ArrowUpRight />
          </CtaButton>
        </div>
      </div>

      <div class="absolute inset-0 z-10 flex flex-col items-center justify-center px-5 pb-28 text-center sm:px-8 md:pb-24">
        <p class="hero-item mb-5 text-[0.7rem] font-semibold tracking-[0.28em] text-white/75 uppercase md:mb-6">
          {landingCopy.eyebrow}
        </p>
        <h1
          class="hero-item mb-5 max-w-4xl text-[clamp(2.35rem,6.2vw,4.35rem)] font-black leading-[1.05] tracking-tight text-white drop-shadow-[0_2px_18px_rgba(0,0,0,0.55)] md:mb-6"
        >
          {landingCopy.headlineLine1}<br />
          {landingCopy.headlineLine2}
        </h1>
        <p class="hero-item max-w-lg text-[0.95rem] leading-relaxed text-white/80 md:text-base">
          {landingCopy.sub}
        </p>
      </div>
    </div>

    <div
      class="absolute inset-x-0 bottom-8 z-20 flex flex-col items-center gap-3 px-6"
      data-cinema-chrome
      hidden
    >
      <button type="button" class="cinema-skip cinema-skip--sound" data-cinema-sound>
        {landingCopy.soundOn}
      </button>
      <button type="button" class="cinema-skip" data-cinema-skip>
        {landingCopy.skip}
      </button>
    </div>

    <p class="sr-only">
      After loading, the SAG film plays. Skip or wait to open the homepage. Explore opens the dashboard. Close returns here, with the video still playing.
    </p>
  </div>
</section>
