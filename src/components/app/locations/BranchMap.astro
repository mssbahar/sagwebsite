---
import type { Branch } from "../../../data/branches";

interface Props {
  branches: Branch[];
}

const { branches } = Astro.props;

const mapData = branches.map((b) => ({
  id: b.id,
  name: b.name,
  lat: b.lat,
  lng: b.lng,
}));
---

<div
  data-branch-map
  data-branches={JSON.stringify(mapData)}
    class="branch-map relative h-full min-h-[280px] w-full overflow-hidden rounded-2xl border border-white/10 md:min-h-[420px] lg:min-h-[520px]"
  role="region"
  aria-label="Branch locations map"
>
</div>
