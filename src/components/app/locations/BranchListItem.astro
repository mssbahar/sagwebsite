---
import { ChevronDown, ExternalLink, Phone, Clock } from "@lucide/astro";
import type { Branch } from "../../../data/branches";
import { branchPayload } from "../../../data/branches";

interface Props {
  branch: Branch;
  active?: boolean;
}

const { branch: b, active = false } = Astro.props;
---

<article
  data-branch-list-item
  data-branch-id={b.id}
  data-branch={branchPayload(b)}
  data-search-text={`${b.name} ${b.region} ${b.address}`.toLowerCase()}
  class:list={["branch-card", active && "is-expanded"]}
  aria-expanded={active ? "true" : "false"}
>
  <button
    type="button"
    data-branch-toggle
    class="branch-card__toggle focus-ring"
    aria-controls={`branch-details-${b.id}`}
    aria-expanded={active ? "true" : "false"}
  >
    <img
      src={b.image}
      alt=""
      class="branch-card__thumb"
      width="56"
      height="56"
      loading="lazy"
    />
    <span class="branch-card__meta">
      <span class="branch-card__name">{b.name}</span>
      <span class="branch-card__address">{b.address}</span>
      <span data-branch-distance class="branch-card__distance" hidden></span>
    </span>
    <ChevronDown size={18} class="branch-card__chevron" aria-hidden="true" />
  </button>

  <div
    id={`branch-details-${b.id}`}
    data-branch-details
    class="branch-card__details"
    hidden={!active}
  >
    <div class="branch-card__details-inner">
      <span class="branch-card__region">{b.region}</span>
      <p class="branch-card__detail-row">
        <Clock size={14} aria-hidden="true" />
        <span>{b.hours}</span>
      </p>
      <p class="branch-card__detail-row">
        <Phone size={14} aria-hidden="true" />
        <a href={`tel:${b.phone.replace(/\s/g, "")}`} class="hover:text-accent focus-ring rounded">
          {b.phone}
        </a>
      </p>
      {
        b.mapsUrl !== "#" && (
          <a
            href={b.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="branch-card__maps focus-ring"
          >
            View on Google Maps
            <ExternalLink size={13} aria-hidden="true" />
          </a>
        )
      }
    </div>
  </div>
</article>
