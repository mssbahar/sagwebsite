---
import { ArrowUpRight } from "@lucide/astro";
import AudioToggle from "./AudioToggle.astro";
import PinkDot from "./PinkDot.astro";
import SocialIcon from "./SocialIcon.astro";
import { site } from "../../data/site";
import { socialLinks } from "../../data/social";

const ig = socialLinks.find((s) => s.icon === "instagram")?.href ?? "#";
const fb = socialLinks.find((s) => s.icon === "facebook")?.href ?? "#";
const tt = socialLinks.find((s) => s.icon === "tiktok")?.href ?? "#";

const glow = "group bento-tile relative overflow-hidden rounded-2xl bg-surface text-left text-white bento-premium focus-ring cursor-pointer";
const notch = "group bento-tile relative overflow-hidden bg-surface text-left text-white clip-notch focus-ring cursor-pointer";
const overlay = "absolute inset-0 bg-gradient-to-t from-black/90 via-black/55 to-black/25";
const topIcon = "dashboard-topbar__icon flex h-11 w-11 shrink-0 items-center justify-center text-white/80 transition-colors hover:text-accent focus-ring sm:h-12 sm:w-12 md:h-16 md:w-16";
---

<section data-view="dashboard" class="view overflow-hidden">
  <div class="absolute inset-0 flex flex-col">
    <div data-dashboard-panel class="relative z-10 flex min-h-0 flex-1 flex-col">
      <div class="relative flex h-full w-full flex-col gap-2 p-2.5 sm:gap-3 sm:p-4 md:p-5 lg:p-6">
        <div class="dashboard-topbar flex shrink-0 items-center justify-between gap-2">
          <button
            type="button"
            data-nav-to="landing"
            data-dashboard-tile
            aria-label="Back to home"
            class={`${topIcon} dashboard-topbar__logo`}
          >
            <img src="/images/logo-primary.png" alt="SAG" class="h-9 w-9 object-contain sm:h-10 sm:w-10 md:h-12 md:w-12" />
          </button>

          <div class="flex shrink-0 items-center gap-1 sm:gap-2">
            <a href={ig} target="_blank" rel="noopener noreferrer" data-dashboard-tile aria-label="Instagram" class={topIcon}>
              <SocialIcon name="instagram" size={18} />
            </a>
            <a href={fb} target="_blank" rel="noopener noreferrer" data-dashboard-tile aria-label="Facebook" class={topIcon}>
              <SocialIcon name="facebook" size={18} />
            </a>
            <a href={tt} target="_blank" rel="noopener noreferrer" data-dashboard-tile aria-label="TikTok" class={`${topIcon} hidden sm:flex`}>
              <SocialIcon name="tiktok" size={18} />
            </a>

            <AudioToggle
              data-dashboard-tile
              class={topIcon}
            />

            <a
              href={site.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Book a service on WhatsApp"
              class="dashboard-topbar__book flex h-11 shrink-0 items-center gap-1.5 px-2 text-white/90 transition-colors hover:text-accent focus-ring sm:h-12 sm:gap-2 md:h-16"
              data-dashboard-tile
            >
              <span class="hidden text-sm font-semibold tracking-wide whitespace-nowrap md:inline">Book Now</span>
              <ArrowUpRight size={18} class="shrink-0" />
            </a>
          </div>
        </div>

        <div
          data-lenis-prevent
          class="dashboard-grid grid min-h-0 flex-1 grid-cols-12 grid-rows-6 gap-2 overflow-y-auto sm:gap-3"
        >
          <button
            type="button"
            data-nav-to="about"
            data-tile-nav
            data-dashboard-tile
            aria-label="What is SAG"
            class={`dashboard-tile dashboard-tile--hero col-span-6 row-span-3 p-5 sm:p-6 ${notch}`}
          >
            <div data-tile-image class="absolute inset-0 bg-cover bg-center" style="background-image:url(/images/branches/branch-02.jpg)"></div>
            <div data-tile-overlay class={overlay}></div>
            <div class="relative flex h-full flex-col justify-between">
              <div class="flex justify-end"><PinkDot icon="Info" lg /></div>
              <div>
                <h2 class="text-3xl font-black leading-[0.95] tracking-tight sm:text-4xl md:text-5xl">What is <span class="text-accent">SAG</span>?</h2>
                <p class="mt-2 max-w-xs text-sm leading-relaxed text-white/75">Malaysia's fastest-growing one-stop automotive solution.</p>
              </div>
            </div>
          </button>

          <button
            type="button"
            data-nav-to="services"
            data-tile-nav
            data-dashboard-tile
            aria-label="Our Services"
            class={`dashboard-tile dashboard-tile--services col-span-3 col-start-7 row-span-4 p-5 ${notch}`}
          >
            <div data-tile-image class="absolute inset-0 bg-cover bg-center" style="background-image:url(/images/branches/branch-05.jpg)"></div>
            <div data-tile-overlay class={overlay}></div>
            <div class="relative flex h-full flex-col justify-between">
              <div class="flex justify-end"><PinkDot icon="Wrench" lg /></div>
              <div>
                <h3 class="text-xl font-black leading-tight tracking-tight sm:text-2xl">Our<br />Services</h3>
              </div>
            </div>
          </button>

          <button
            type="button"
            data-nav-to="locations"
            data-tile-nav
            data-dashboard-tile
            aria-label="Our Branches"
            class={`dashboard-tile dashboard-tile--branches col-span-3 col-start-10 row-span-3 p-4 sm:p-5 ${glow}`}
          >
            <div data-tile-image class="absolute inset-0 bg-cover bg-center" style="background-image:url(/images/branches/branch-09.jpg)"></div>
            <div data-tile-overlay class={overlay}></div>
            <div class="relative flex h-full flex-col justify-between">
              <div class="flex justify-end"><PinkDot icon="MapPin" /></div>
              <h3 class="text-lg font-black leading-tight tracking-tight sm:text-xl">Our<br />Branches</h3>
            </div>
          </button>

          <div
            data-dashboard-tile
            class="dashboard-tile dashboard-tile--stats col-span-2 row-span-3 row-start-4 p-3 clip-notch-b relative overflow-hidden text-white glass-tile sm:p-4"
          >
            <div class="flex h-full flex-col items-center justify-between py-1 text-center sm:py-2">
              <div>
                <div class="text-xl font-black leading-none tabular-nums sm:text-2xl" data-counter="11" data-suffix="" data-numeric="true">11</div>
                <p class="mt-1 text-[10px] leading-tight text-white/60 sm:mt-1.5 sm:text-xs">Branches nationwide</p>
              </div>
              <div>
                <div class="text-xl font-black leading-none tabular-nums sm:text-2xl" data-counter="200" data-suffix="+" data-numeric="true">200+</div>
                <p class="mt-1 text-[10px] leading-tight text-white/60 sm:mt-1.5 sm:text-xs">Staff members</p>
              </div>
              <div>
                <div class="text-xl font-black leading-none tabular-nums sm:text-2xl" data-counter="20" data-suffix="" data-numeric="true">20</div>
                <p class="mt-1 text-[10px] leading-tight text-white/60 sm:mt-1.5 sm:text-xs">Years experience</p>
              </div>
            </div>
          </div>

          <button
            type="button"
            data-nav-to="reviews"
            data-tile-nav
            data-dashboard-tile
            aria-label="Customer Reviews"
            class={`dashboard-tile dashboard-tile--reviews col-span-4 col-start-3 row-span-3 row-start-4 p-4 sm:p-5 ${glow}`}
          >
            <div data-tile-image class="absolute inset-0 bg-cover bg-center" style="background-image:url(/images/branches/branch-07.jpg)"></div>
            <div data-tile-overlay class={overlay}></div>
            <div class="relative flex h-full flex-col justify-between">
              <div class="flex justify-end"><PinkDot icon="Star" /></div>
              <h3 class="text-lg font-black leading-tight tracking-tight sm:text-xl">Customer<br />Reviews</h3>
            </div>
          </button>

          <button
            type="button"
            data-nav-to="workshop"
            data-tile-nav
            data-dashboard-tile
            aria-label="Workshop Facilities"
            class={`dashboard-tile dashboard-tile--workshop col-span-3 col-start-7 row-span-2 row-start-5 p-4 sm:p-5 ${glow}`}
          >
            <div data-tile-image class="absolute inset-0 bg-cover bg-center" style="background-image:url(/images/branches/branch-01.jpg)"></div>
            <div data-tile-overlay class={overlay}></div>
            <div class="relative flex h-full flex-col justify-between">
              <div class="flex justify-end"><PinkDot icon="Settings" /></div>
              <h3 class="text-lg font-black leading-tight tracking-tight sm:text-xl">Workshop<br />Facilities</h3>
            </div>
          </button>

          <button
            type="button"
            data-nav-to="contact"
            data-tile-nav
            data-dashboard-tile
            aria-label="Contact Us"
            class={`dashboard-tile dashboard-tile--contact col-span-3 col-start-10 row-span-3 row-start-4 p-4 sm:p-5 ${glow}`}
          >
            <div data-tile-image class="absolute inset-0 bg-cover bg-center" style="background-image:url(/images/branches/branch-10.jpg)"></div>
            <div data-tile-overlay class={overlay}></div>
            <div class="relative flex h-full flex-col justify-between">
              <div class="flex justify-end"><PinkDot icon="Phone" /></div>
              <h3 class="text-lg font-black leading-tight tracking-tight sm:text-xl">Contact<br />Us</h3>
            </div>
          </button>
        </div>
      </div>
    </div>
    <div data-explore-close-anchor class="dashboard-cta-anchor relative z-20 flex min-h-[3.25rem] shrink-0 justify-center px-0 pb-0 pt-1 md:min-h-[4.25rem] md:px-4 md:pb-6 md:pt-2"></div>
  </div>
</section>
