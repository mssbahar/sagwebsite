---
import CtaButton from "./CtaButton.astro";
import { site } from "../../data/site";

interface Props {
  heading: string;
  cta?: string;
  bgImg: string;
  class?: string;
}

const { heading, cta = "Book a Service", class: className = "" } = Astro.props;
---

<div class:list={["cta-banner", className]}>
  <div class="cta-banner__bg" aria-hidden="true"></div>
  <div class="cta-banner__content">
    <img class="cta-banner__logo" src="/images/logo-primary.png" alt="" width="72" height="68" />
    <h2 class="cta-banner__heading" set:html={heading}></h2>
    <CtaButton href={site.whatsappUrl} external variant="solid" class="cta-banner__btn">
      {cta}
    </CtaButton>
  </div>
</div>
